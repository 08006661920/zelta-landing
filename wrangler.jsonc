{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // zelta-digital.com como Worker con assets (migrado de Vercel, 10/2026). Mismo molde que los clientes.
  "name": "zelta-digital",
  "compatibility_date": "2026-10-29",
  "main": "src/worker.js",
  // La raíz del repo es la carpeta de assets: lo que se publica lo decide la lista de .assetsignore
  // (todo ignorado salvo lo que se nombra). Archivo nuevo de la página → sumarlo ahí.
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    // Host al que redirigen www y http (vacío = sin redirección).
    "CANONICO": "zelta-digital.com"
  },
  // /clientes/* lo atiende el panel (Worker `zelta-panel`, código en el repo PRIVADO zelta-clientes).
  "services": [{ "binding": "PANEL", "service": "zelta-panel" }],
  "workers_dev": false,
  // cv.zelta-digital.com NO va acá: sigue en Vercel.
  "routes": [
    { "pattern": "zelta-digital.com", "custom_domain": true },
    { "pattern": "www.zelta-digital.com", "custom_domain": true }
  ]
}
